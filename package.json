{
  "name": "ctk_vue3_ts_template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "lint-staged": {
    "src/**/*.{js,jsx,cjs,ts,vue}": [
      "npm run lint"
    ]
  },
  "scripts": {
    "prepare": "husky install",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --mode development",
    "build:prod": "vue-tsc --noEmit && vite build --mode production",
    "lint": "vue-tsc --noEmit",
    "format": "prettier --write \"./**/*.{html,vue,ts,js,json,md,less,sass,scss,sty}\""
  },
  "dependencies": {
    "@iconify/utils": "^2.3.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.15.21",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^13.2.0",
    "axios": "^1.9.0",
    "crypto-js": "^4.2.0",
    "loadash": "^1.0.0",
    "lodash": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.3.0",
    "sass": "^1.89.0",
    "unocss": "66.1.0-beta.7",
    "unplugin-auto-import": "^19.2.0",
    "unplugin-vue-components": "^28.5.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-removelog": "^0.2.2",
    "vite-plugin-restart": "^0.4.2",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vue": "^3.5.14",
    "vue-i18n": "^11.1.4",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@unocss/preset-rem-to-px": "66.1.0-beta.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "naive-ui": "^2.41.0",
    "prettier": "3.5.3",
    "typescript": "~5.7.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
